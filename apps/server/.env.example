# Puerto HTTP del servidor
PORT=4000

# sim  = colectivos simulados (no necesita credenciales, ideal para desarrollar)
# live = API de Transporte de la Ciudad (necesita BA_CLIENT_ID y BA_CLIENT_SECRET)
DATA_MODE=sim

# Credenciales de https://www.buenosaires.gob.ar/form/formulario-de-registro-api-transporte
BA_CLIENT_ID=
BA_CLIENT_SECRET=
BA_API_BASE=https://apitransporte.buenosaires.gob.ar

# expo = manda push reales via Expo Push API · log = solo las imprime (desarrollo)
PUSH_MODE=log
# Opcional: token de acceso de Expo si activás "enhanced push security"
EXPO_ACCESS_TOKEN=

# Archivo SQLite donde se guardan dispositivos, alarmas y notificaciones
DB_PATH=./data/bondiar.db

# Cada cuántos segundos se revisan las alarmas activas
SCHEDULER_INTERVAL_SECONDS=15
