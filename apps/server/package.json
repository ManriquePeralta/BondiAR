{
  "name": "@bondiar/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de BondiAR: llegadas en tiempo real, alarmas de salida y notificaciones push para CABA.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "tsx scripts/probe-api.ts",
    "import:gtfs": "tsx scripts/import-gtfs.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
